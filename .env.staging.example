DJANGO_DEBUG=False
DJANGO_USE_SQLITE=False
DJANGO_SECRET_KEY=change-me-strong-secret
JWT_SIGNING_KEY=change-me-strong-jwt-secret
DJANGO_ALLOWED_HOSTS=staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
CSRF_TRUSTED_ORIGINS=https://staging.example.com

POSTGRES_DB=jurisai
POSTGRES_USER=jurisai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://jurisai:change-me@db:5432/jurisai

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
CELERY_BROKER_URL=redis://:change-me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/0

FLOWER_USER=admin
FLOWER_PASSWORD=change-me
RUN_COLLECTSTATIC=True

# OCR tenant limits are controlled per organization through OCR settings endpoints.
# Keep this placeholder only as an operational reminder for staging rollout notes.
OCR_MAX_SCANNED_PDF_PAGES=10

SENTRY_DSN=
LOG_LEVEL=INFO

OPENAI_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-user
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=jurisai@staging.example.com
