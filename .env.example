DJANGO_SECRET_KEY=replace-me-with-a-secure-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Use DJANGO_USE_SQLITE=True only for local development outside Docker/Compose.
# Do not enable this in production.
DJANGO_USE_SQLITE=False
POSTGRES_DB=jurisai
POSTGRES_USER=jurisai
POSTGRES_PASSWORD=jurisai
# POSTGRES_HOST=db is expected when running through Docker Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
FLOWER_USER=admin
FLOWER_PASSWORD=change-me
RUN_COLLECTSTATIC=False
OPENAI_API_KEY=your-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-user
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=jurisai@localhost
