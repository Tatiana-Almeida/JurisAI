DJANGO_SECRET_KEY=replace-me-with-a-secure-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Use DJANGO_USE_SQLITE=True only for local development outside Docker/Compose.
# Do not enable this in production.
DJANGO_USE_SQLITE=False
POSTGRES_DB=jurisai
POSTGRES_USER=jurisai
POSTGRES_PASSWORD=jurisai
# POSTGRES_HOST=db is expected when running through Docker Compose.
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
OPENAI_API_KEY=your-api-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-user
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=jurisai@localhost
